<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<PlatformTarget>x64</PlatformTarget>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
	<SelfContained>false</SelfContained>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<SatSdkBin Condition="'$(SatSdkBin)' == ''">$(MSBuildProjectDirectory)\..\sdk</SatSdkBin>
  </PropertyGroup>

  <ItemGroup>
	<SatManagedAssembly Include="BouncyCastle.Cryptography;OMSp_ASOM;OMSp_managed_linux;SharpSnmpLib;SIMATICAutomationToolAPI;SIMATICAutomationToolOSLCommon;SIMATICAutomationToolOSLWindows" />
	<Reference Include="@(SatManagedAssembly)">
	  <HintPath>$(SatSdkBin)\%(Identity).dll</HintPath>
	  <Private>true</Private>
	</Reference>
	<SatNativeLibrary Include="CfCore.dll;DeviceManagerClient.dll;Ijwhost.dll;IOMS_1600.dll;libWCCILbasics.dll;libWCCILclientSideLibrary.dll;RTILtrace.5.0.dll;SIMATICAutomationUCP.dll;StreamingFileTransfer.dll;wrapper_native.dll" />
	<None Include="@(SatNativeLibrary->'$(SatSdkBin)\%(Identity)')" Link="%(Filename)%(Extension)"
		  CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
		  ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="RequireSatSdk" BeforeTargets="ResolveAssemblyReferences;ComputeFilesToPublish">
	<Error Condition="!Exists('$(SatSdkBin)\%(SatManagedAssembly.Identity).dll')"
		   Text="Missing SAT SDK assembly: $(SatSdkBin)\%(SatManagedAssembly.Identity).dll. Set SatSdkBin to the Windows x64 SDK directory." />
	<Error Condition="!Exists('$(SatSdkBin)\%(SatNativeLibrary.Identity)')"
		   Text="Missing SAT SDK native library: $(SatSdkBin)\%(SatNativeLibrary.Identity). Set SatSdkBin to the Windows x64 SDK directory." />
  </Target>

</Project>
