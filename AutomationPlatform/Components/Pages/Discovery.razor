@page "/Discovery"
@rendermode InteractiveServer

@implements IDisposable

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>设备发现与工程操作</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">本机网络接口</MudText>

<MudText Typo="Typo.body1" Class="mb-4">列出服务器本机网络适配器，选择网卡扫描设备。扫描范围：@(string.IsNullOrWhiteSpace(Settings.ScanFilter) ? "不限" : Settings.ScanFilter)</MudText>

<MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@IsBusy" OnClick="LoadNetworkInterfaces">@(isLoading ? "正在枚举..." : "列出网卡")</MudButton>

<MudPaper Class="pa-4 mt-4">
    @if (isLoading)
    {
        <MudText Typo="Typo.body2">正在查询...</MudText>
    }
    else if (errorMessage != null)
    {
        <MudText Typo="Typo.body2" Color="Color.Error">@errorMessage</MudText>
    }
    else if (networkInterfaces == null)
    {
        <MudText Typo="Typo.body2">尚未查询。</MudText>
    }
    else if (networkInterfaces.Count == 0)
    {
        <MudText Typo="Typo.body2">未发现任何网络接口。</MudText>
    }
    else
    {
        <MudList T="string" Dense="true">
            @for (int i = 0; i < networkInterfaces.Count; i++)
            {
                var index = i;
                var item = networkInterfaces[i];
                @* 捕获变量，避免闭包问题 *@
                <MudListItem OnClick="@(() => OnItemClick(item))">@(index). @item</MudListItem>
            }
        </MudList>
    }
</MudPaper>

<MudPaper Class="pa-4 mt-4">
    <MudText Typo="Typo.h6" GutterBottom="true">扫描到的设备</MudText>
    @if (selectedItem != null)
    {
        <MudText Typo="Typo.body2">当前网卡：@selectedItem</MudText>
    }
    @if (scanErrorMessage != null)
    {
        <MudAlert Severity="Severity.Warning">@scanErrorMessage</MudAlert>
    }
    @if (isScanning)
    {
        <MudText Typo="Typo.body2">正在扫描设备...</MudText>
    }
    else if (scannedDevices == null)
    {
        <MudText Typo="Typo.body2">请选择网卡开始扫描。</MudText>
    }
    else if (scannedDevices.Count == 0)
    {
        <MudText Typo="Typo.body2">未扫描到设备。</MudText>
    }
    else
    {
        <MudList T="DiscoveredDevice" Dense="true">
            @foreach (var device in scannedDevices)
            {
                <MudListItem>
                    <div>
                        <MudText>@device.IpAddress · @device.ProfinetName · @device.Description</MudText>
                        <MudText Typo="Typo.body2">MAC：@device.MacAddress · 订货号：@device.ArticleNumber</MudText>
                        @if (device.OperatingMode != null)
                        {
                            <MudText Typo="Typo.body2">运行状态：@device.OperatingMode</MudText>
                        }
                        @if (device.StatusError != null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Warning">状态刷新失败：@device.StatusError</MudText>
                        }
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

<MudPaper Class="pa-4 mt-4">
    <MudText Typo="Typo.h6" GutterBottom="true">工程操作</MudText>
    <MudAlert Severity="Severity.Info" Class="mb-4">工程操作不使用上方扫描结果。比较使用配置的 TIA 工程及工程设备；上传仍使用 OpennessServices 内部既有网卡和 IP 配置。</MudAlert>
    <MudText Typo="Typo.body2">比较工程：@Settings.TiaProjectPath</MudText>
    <MudText Typo="Typo.body2">工程设备：@Settings.TiaDeviceName</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">上传目录：@Settings.UploadDirectory</MudText>
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" Disabled="@IsBusy" OnClick="CompareDeviceAsync">@(isComparing ? "比较中..." : "比较配置工程")</MudButton>
    <MudButton Color="Color.Secondary" Variant="Variant.Outlined" Disabled="@IsBusy" OnClick="UploadDeviceAsync">@(isUploading ? "上传中..." : "上传配置站点")</MudButton>
    @if (isComparing || isUploading)
    {
        <MudButton Color="Color.Warning" Disabled="@(operationCancellation?.IsCancellationRequested == true)" OnClick="CancelOperation">取消本次操作</MudButton>
    }
</MudPaper>

@if (compareErrorMessage != null || compareResultMessage != null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6" GutterBottom="true">在线程序比较结果</MudText>
        @if (compareErrorMessage != null)
        {
            <MudText Color="Color.Error" Typo="Typo.body2" Style="white-space: pre-line">@compareErrorMessage</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Style="white-space: pre-line">@compareResultMessage</MudText>
        }
    </MudPaper>
}

@if (uploadErrorMessage != null || uploadResultMessage != null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6" GutterBottom="true">上传项目结果</MudText>
        @if (uploadErrorMessage != null)
        {
            <MudText Color="Color.Error" Typo="Typo.body2" Style="white-space: pre-line">@uploadErrorMessage</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Style="white-space: pre-line">@uploadResultMessage</MudText>
        }
    </MudPaper>
}

