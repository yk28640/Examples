@page "/settings"
@page "/setting"
@rendermode InteractiveServer
@inject ProjectDirectoryService Directories
@inject StationBatchUploadService BatchUploads
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject ILogger<Settings> Logger
@implements IDisposable

<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>项目设置</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">项目设置</MudText>
<MudText Class="mb-4">服务端根目录：@Directories.RootPath</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4">
    点击 AP 新增 Line 线体，点击 Line 新增 ST 工站。Line 线体不配置 IP；在 Line 下填写的 IP 仅属于新建的 ST 工站。
    前缀固定，只需输入后缀。新增 ST 时需配置工站 IP，后续可在选中 ST 后查看和修改。
    仅显示符合命名和层级规则的实际目录，不显示普通文件、其他目录及符号链接。
    重命名保留目录内容；删除仅限空目录（ST 目录仅含 IP 配置文件时也允许删除），AP 根目录不可重命名或删除。
</MudAlert>

<MudButton OnClick="RefreshAsync" Disabled="@busy" StartIcon="@Icons.Material.Filled.Refresh"
           Variant="Variant.Outlined" Class="mb-4">刷新目录</MudButton>
@if (busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h6" GutterBottom="true">工站工程批量上传</MudText>
    <MudText Class="mb-3">按服务器本地时间每天上传一次，也可以立即执行。逐个读取 AP 下各 ST 的 IP，并将上传的工程保存到对应 ST 文件夹；未配置或无效 IP 的工站会跳过。</MudText>
    <label for="daily-upload-time">每日上传时间</label>
    <input id="daily-upload-time" type="time" value="@dailyTime"
           @onchange="@(e => dailyTime = e.Value?.ToString() ?? string.Empty)"
           disabled="@scheduleSaving" class="ml-2 mr-2" />
    <MudButton OnClick="SaveDailyTimeAsync" Variant="Variant.Outlined" Color="Color.Primary"
               Disabled="@scheduleSaving">保存时间</MudButton>
    <MudButton OnClick="DisableDailyTimeAsync" Variant="Variant.Outlined" Color="Color.Error" Class="ml-2"
               Disabled="@(scheduleSaving || string.IsNullOrEmpty(BatchUploads.DailyTime))">关闭定时</MudButton>
    <MudButton OnClick="StartBatchUpload" Variant="Variant.Filled" Color="Color.Secondary" Class="ml-3"
               Disabled="@(busy || scheduleSaving || BatchUploads.Status.IsRunning)">立即上传全部工站</MudButton>
    <MudText Typo="Typo.body2" Class="mt-3">当前定时：@(BatchUploads.DailyTime is { } time ? $"每天 {time}（服务器本地时间）" : "未启用")</MudText>
    @if (BatchUploads.ScheduleError is { } scheduleError)
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@scheduleError</MudAlert>
    }
    @if (BatchUploads.Status.IsRunning)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
    }
    @if (BatchUploads.Status.Trigger is not null)
    {
        <MudText Class="mt-3">@BatchUploads.Status.Trigger 触发：@(BatchUploads.Status.IsRunning ? "正在上传" : "已结束")；已处理 @BatchUploads.Status.Results.Count 个工站。</MudText>
        @if (BatchUploads.Status.Error is { } batchError)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@batchError</MudAlert>
        }
        @foreach (var result in BatchUploads.Status.Results)
        {
            <MudAlert Severity="@(result.State == "成功" ? Severity.Success : Severity.Warning)" Class="mt-2">
                <strong>@result.Station</strong> (@(result.IpAddress ?? "无 IP"))：@result.State
                <div style="white-space: pre-wrap; overflow-wrap: anywhere">@result.Message</div>
            </MudAlert>
        }
    }
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4">
            @if (root is not null)
            {
                <MudTreeView T="string" SelectedValue="@selectedPath" SelectedValueChanged="SelectNode"
                             SelectionMode="SelectionMode.SingleSelection" Disabled="@busy">
                    <MudTreeViewItem T="string" Value="@root.RelativePath" Text="AP"
                                     Icon="@Icons.Material.Filled.Folder" @bind-Expanded="rootExpanded">
                        @foreach (var line in root.Children)
                        {
                            <MudTreeViewItem T="string" @key="line.RelativePath" Value="@line.RelativePath" Text="@line.Name"
                                             Icon="@Icons.Material.Filled.Folder"
                                             Expanded="@expandedLines.Contains(line.RelativePath)"
                                             ExpandedChanged="@(expanded => SetExpanded(line.RelativePath, expanded))">
                                @foreach (var station in line.Children)
                                {
                                    <MudTreeViewItem T="string" @key="station.RelativePath" Value="@station.RelativePath"
                                                     Text="@GetStationTreeText(station)" Icon="@Icons.Material.Filled.Folder" />
                                }
                            </MudTreeViewItem>
                        }
                    </MudTreeViewItem>
                </MudTreeView>
            }
            else
            {
                <MudText>目录尚未加载，请检查磁盘和应用运行账户的权限后重试。</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="7">
        @if (selectedNode is not null)
        {
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">@selectedNode.Name</MudText>
                <MudText Class="mb-4" Style="overflow-wrap:anywhere">@SelectedFullPath</MudText>
                @if (selectedNode.Level < 2)
                {
                    <MudTextField T="string" @bind-Value="newSuffix" Label="@(selectedNode.Level == 0 ? "线体名称后缀" : "工站名称后缀")"
                                  Adornment="Adornment.Start" AdornmentText="@CreatePrefix"
                                  Variant="Variant.Outlined" Immediate="true" Disabled="@busy" />
                    @if (selectedNode.Level == 1)
                    {
                        <MudTextField T="string" @bind-Value="newStationIp" Label="新建 ST 工站 IP"
                                      Placeholder="例如 192.168.98.10"
                                      Variant="Variant.Outlined" Immediate="true" Disabled="@busy" Class="mt-3" />
                    }
                    <MudButton OnClick="CreateAsync" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3"
                               Disabled="@(busy || string.IsNullOrWhiteSpace(newSuffix) || (selectedNode.Level == 1 && string.IsNullOrWhiteSpace(newStationIp)))">
                        @(selectedNode.Level == 0 ? "新增线体" : "新增工站")
                    </MudButton>
                }
                @if (selectedNode.Level == 2)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle2">工站 IP：@(selectedNode.StationIpAddress ?? "未配置")</MudText>
                    @if (!string.IsNullOrWhiteSpace(selectedNode.StationIpError))
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-2">@selectedNode.StationIpError</MudAlert>
                    }
                    <MudTextField T="string" @bind-Value="stationIpInput" Label="工站 IP"
                                  Placeholder="例如 192.168.98.10"
                                  Variant="Variant.Outlined" Immediate="true" Disabled="@busy" Class="mt-3" />
                    <MudButton OnClick="SaveStationIpAsync" Variant="Variant.Filled" Color="Color.Secondary" Class="mt-3"
                               Disabled="@(busy || string.IsNullOrWhiteSpace(stationIpInput))">保存工站 IP</MudButton>
                }
                @if (selectedNode.Level > 0)
                {
                    <MudDivider Class="my-4" />
                    <MudTextField T="string" @bind-Value="renameSuffix" Label="重命名后缀"
                                  Adornment="Adornment.Start" AdornmentText="@RenamePrefix"
                                  Variant="Variant.Outlined" Immediate="true" Disabled="@busy" />
                    <MudButton OnClick="RenameAsync" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3"
                               Disabled="@(busy || string.IsNullOrWhiteSpace(renameSuffix))">重命名</MudButton>
                    <MudButton OnClick="DeleteAsync" Variant="Variant.Outlined" Color="Color.Error" Class="mt-3 ml-3"
                               Disabled="@busy" StartIcon="@Icons.Material.Filled.Delete">删除空目录</MudButton>
                }
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private ProjectDirectoryNode? root;
    private ProjectDirectoryNode? selectedNode;
    private string? selectedPath;
    private string newSuffix = string.Empty;
    private string newStationIp = string.Empty;
    private string stationIpInput = string.Empty;
    private string renameSuffix = string.Empty;
    private string? errorMessage;
    private bool busy;
    private bool scheduleSaving;
    private bool disposed;
    private string dailyTime = string.Empty;
    private bool rootExpanded = true;
    private readonly HashSet<string> expandedLines = new(StringComparer.OrdinalIgnoreCase);

    private string CreatePrefix => selectedNode?.Level == 0 ? "Line" : "ST";
    private string RenamePrefix => selectedNode?.Level == 1 ? "Line" : "ST";
    private string SelectedFullPath => Path.Combine(Directories.RootPath, selectedPath ?? string.Empty);
    private static string GetStationTreeText(ProjectDirectoryNode station) =>
        string.IsNullOrWhiteSpace(station.StationIpAddress)
            ? station.Name
            : $"{station.Name}  —  {station.StationIpAddress}";

    protected override async Task OnInitializedAsync()
    {
        dailyTime = BatchUploads.DailyTime ?? string.Empty;
        BatchUploads.Changed += OnBatchChanged;
        await RefreshAsync();
    }

    private void OnBatchChanged()
    {
        if (!disposed)
            _ = InvokeAsync(StateHasChanged);
    }

    private async Task SaveDailyTimeAsync()
    {
        if (scheduleSaving)
            return;

        scheduleSaving = true;
        try
        {
            var time = dailyTime;
            await Task.Run(() => BatchUploads.SaveDailyTime(time));
            dailyTime = BatchUploads.DailyTime ?? string.Empty;
            Snackbar.Add("每日上传时间已保存。", Severity.Success);
        }
        catch (Exception exception)
        {
            ReportError(exception, "保存每日上传时间失败");
        }
        finally
        {
            scheduleSaving = false;
        }
    }

    private async Task DisableDailyTimeAsync()
    {
        if (scheduleSaving)
            return;

        scheduleSaving = true;
        try
        {
            await Task.Run(() => BatchUploads.DisableDailyTime());
            dailyTime = string.Empty;
            Snackbar.Add("已关闭每日定时上传。", Severity.Info);
        }
        catch (Exception exception)
        {
            ReportError(exception, "关闭每日定时上传失败");
        }
        finally
        {
            scheduleSaving = false;
        }
    }

    private void StartBatchUpload()
    {
        if (!BatchUploads.TryStartManual())
            Snackbar.Add("已有上传任务正在执行，或应用正在停止。", Severity.Warning);
    }

    public void Dispose()
    {
        disposed = true;
        BatchUploads.Changed -= OnBatchChanged;
    }

    private void SetExpanded(string path, bool expanded)
    {
        if (expanded)
            expandedLines.Add(path);
        else
            expandedLines.Remove(path);
    }

    private void SelectNode(string? path)
    {
        selectedNode = FindNode(path) ?? root;
        selectedPath = selectedNode?.RelativePath;
        newSuffix = string.Empty;
        newStationIp = string.Empty;
        stationIpInput = selectedNode?.Level == 2 ? selectedNode.StationIpAddress ?? string.Empty : string.Empty;
        renameSuffix = selectedNode is { Level: > 0 } ? selectedNode.Name[RenamePrefix.Length..] : string.Empty;
    }

    private ProjectDirectoryNode? FindNode(string? path)
    {
        if (root is null || path is null)
            return null;

        return new[] { root }.Concat(root.Children).Concat(root.Children.SelectMany(line => line.Children))
            .FirstOrDefault(node => string.Equals(node.RelativePath, path, StringComparison.OrdinalIgnoreCase));
    }

    private async Task LoadAsync(string? path)
    {
        root = await Task.Run(Directories.Load);
        expandedLines.IntersectWith(root.Children.Select(line => line.RelativePath));
        SelectNode(path);
        if (selectedNode is { Level: > 0 })
        {
            rootExpanded = true;
            expandedLines.Add(selectedNode.Level == 1 ? selectedNode.RelativePath : Path.GetDirectoryName(selectedNode.RelativePath)!);
        }
    }

    private async Task RefreshAsync()
    {
        if (busy)
            return;

        busy = true;
        errorMessage = null;
        try
        {
            await LoadAsync(selectedPath);
        }
        catch (Exception exception)
        {
            root = null;
            SelectNode(null);
            ReportError(exception, "加载目录失败");
        }
        finally
        {
            busy = false;
        }
    }

    private Task CreateAsync()
    {
        var parent = selectedPath;
        var suffix = newSuffix;
        var stationIp = selectedNode?.Level == 1 ? newStationIp : null;
        return parent is null ? Task.CompletedTask : ExecuteAsync(() => Directories.Create(parent, suffix, stationIp), "目录已创建。");
    }

    private Task SaveStationIpAsync()
    {
        var path = selectedPath;
        var stationIp = stationIpInput;
        return path is null || selectedNode?.Level != 2
            ? Task.CompletedTask
            : ExecuteAsync(() => Directories.SetStationIp(path, stationIp), "工站 IP 已保存。");
    }

    private Task RenameAsync()
    {
        var path = selectedPath;
        var suffix = renameSuffix;
        return path is null ? Task.CompletedTask : ExecuteAsync(() => Directories.Rename(path, suffix), "目录已重命名。");
    }

    private async Task DeleteAsync()
    {
        if (busy || selectedNode is not { Level: > 0 })
            return;

        var node = selectedNode;
        busy = true;
        bool? confirmed;
        try
        {
            confirmed = await Dialogs.ShowMessageBoxAsync("确认删除空目录",
                $"确定删除 {node.Name} 吗？路径：{Path.Combine(Directories.RootPath, node.RelativePath)}。仅允许删除空目录；工站目录仅包含 IP 配置文件时也可删除。包含工站、文件或其他目录时将拒绝删除。",
                yesText: "删除", cancelText: "取消");
        }
        catch (Exception exception)
        {
            ReportError(exception, "无法打开删除确认窗口");
            return;
        }
        finally
        {
            busy = false;
        }

        if (confirmed == true)
        {
            await ExecuteAsync(() =>
            {
                Directories.Delete(node.RelativePath);
                return Path.GetDirectoryName(node.RelativePath) ?? string.Empty;
            }, "空目录已删除。");
        }
    }

    private async Task ExecuteAsync(Func<string> operation, string successMessage)
    {
        if (busy)
            return;

        busy = true;
        errorMessage = null;
        var saved = false;
        try
        {
            var path = await Task.Run(operation);
            saved = true;
            await LoadAsync(path);
            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (Exception exception)
        {
            if (saved)
            {
                root = null;
                SelectNode(null);
            }
            ReportError(exception, saved ? "目录操作已完成，但刷新失败，请重新加载" : "目录操作失败");
        }
        finally
        {
            busy = false;
        }
    }

    private void ReportError(Exception exception, string context)
    {
        Logger.LogError(exception, "{Context}，项目根目录：{RootPath}", context, Directories.RootPath);
        var detail = exception switch
        {
            UnauthorizedAccessException => "权限不足，请为应用运行账户授予目标目录的读取及修改权限。",
            System.Security.SecurityException => "访问被安全策略拒绝，请检查应用运行账户的权限。",
            DirectoryNotFoundException => "磁盘或目录不存在，请检查 E 盘及目标目录后刷新。",
            FileNotFoundException => "目标已不存在，请刷新目录后重试。",
            PathTooLongException => "目录路径过长，请缩短节点名称。",
            ArgumentException or InvalidOperationException => exception.Message,
            IOException => "文件系统操作失败，目录可能被占用、非空或已被其他程序修改，请检查后刷新。",
            _ => "发生未知错误，请查看应用日志后重试。"
        };
        errorMessage = $"{context}：{detail}";
        if (RendererInfo.IsInteractive)
        {
            Snackbar.Add(errorMessage, Severity.Error);
        }
    }
}
